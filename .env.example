# Copy to .env.local. None of these are required for a working map.

# Optional. Auth, dinner interest, stories.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional self-hosted tiles. Leave blank — OpenFreeMap dark ships by default.
NEXT_PUBLIC_PMTILES_URL=

# Optional Protomaps API key. Ignored if missing or a placeholder.
# Never required. A bad key is what printed "API key required" on the last preview.
NEXT_PUBLIC_PROTOMAPS_KEY=

# Optional MapTiler key. Used only when set to a real key (dataviz-dark).
# Do not point a style URL at MapTiler without this — their tiles watermark.
NEXT_PUBLIC_MAPTILER_KEY=
