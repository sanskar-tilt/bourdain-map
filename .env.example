# Copy to .env.local. None of these are required for a working map.

# Optional. Auth, dinner interest, stories.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Preview ships a light paper basemap (Carto Positron) with no key,
# plus a Dark Matter night toggle. Set a real Protomaps key later on Vercel
# if you want vector tiles.
NEXT_PUBLIC_PMTILES_URL=
NEXT_PUBLIC_PROTOMAPS_KEY=

# Do not set unless you have a working MapTiler key. Missing keys watermark
# the map with "API key required".
NEXT_PUBLIC_MAPTILER_KEY=
